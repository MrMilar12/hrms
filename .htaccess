RewriteEngine On

# Remove the implementation folder from old bookmarks, then internally route
# clean /hrms/... URLs through the public front controller.
RewriteCond %{THE_REQUEST} \s/+hrms/public(?:[/?\s]|$) [NC]
RewriteRule ^public(?:/(.*))?$ /hrms/$1 [R=301,L,NE]

RewriteCond %{REQUEST_URI} !^/hrms/public(?:/|$) [NC]
RewriteRule ^(.*)$ public/$1 [L]
